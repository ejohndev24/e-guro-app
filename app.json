{
  "expo": {
    "name": "E-Guro",
    "slug": "e-guro-app",
    "version": "1.0.0",
    "icon": "./assets/images/e-guro-icon.png",
    "orientation": "portrait",
    "scheme": "eguro",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/e-guro-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eguro.app"
    },
    "android": {
      "package": "com.eguro.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/e-guro-icon.png",
        "backgroundColor": "#075DDF"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}